{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "ZimAgriTrust – Production Business & API Dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🏥 System Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "API Status",
      "type": "stat",
      "targets": [{ "expr": "up{job=\"agritrust-backend\"}", "legendFormat": "Backend" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 0.2 }] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "API p95 Latency",
      "type": "stat",
      "targets": [{ "expr": "agritrust_http_request_duration_seconds{quantile=\"0.95\"}", "legendFormat": "p95" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Requests / sec",
      "type": "stat",
      "targets": [{ "expr": "rate(agritrust_http_requests_total[1m])", "legendFormat": "RPS" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }] } } },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Error Rate",
      "type": "stat",
      "targets": [{ "expr": "rate(agritrust_http_requests_total{status=~\"5..\"}[5m]) / rate(agritrust_http_requests_total[5m])", "legendFormat": "Error %" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Uptime",
      "type": "stat",
      "targets": [{ "expr": "agritrust_uptime_seconds", "legendFormat": "Uptime" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "📊 API Performance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Request Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "targets": [
        { "expr": "agritrust_http_request_duration_seconds{quantile=\"0.5\"}", "legendFormat": "p50 {{path}}" },
        { "expr": "agritrust_http_request_duration_seconds{quantile=\"0.95\"}", "legendFormat": "p95 {{path}}" },
        { "expr": "agritrust_http_request_duration_seconds{quantile=\"0.99\"}", "legendFormat": "p99 {{path}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Request Rate by Status",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(agritrust_http_requests_total{status=~\"2..\"}[1m]))", "legendFormat": "2xx OK" },
        { "expr": "sum(rate(agritrust_http_requests_total{status=~\"4..\"}[1m]))", "legendFormat": "4xx Client Error" },
        { "expr": "sum(rate(agritrust_http_requests_total{status=~\"5..\"}[1m]))", "legendFormat": "5xx Server Error" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "💼 Business Metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 15 },
      "id": 20,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Total Listings",
      "type": "stat",
      "targets": [{ "expr": "agritrust_business_events_total{metric=\"listings_created\"}", "legendFormat": "Listings" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 15 },
      "id": 21,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Total GMV (Gross Merchandise Value)",
      "type": "stat",
      "targets": [{ "expr": "agritrust_business_events_total{metric=\"gmv_usd\"}", "legendFormat": "GMV" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 15 },
      "id": 22,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Active Farmers",
      "type": "stat",
      "targets": [{ "expr": "agritrust_business_events_total{metric=\"active_farmers\"}", "legendFormat": "Farmers" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 15 },
      "id": 23,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "USSD Sessions Today",
      "type": "stat",
      "targets": [{ "expr": "increase(agritrust_business_events_total{metric=\"ussd_sessions\"}[24h])", "legendFormat": "USSD" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 15 },
      "id": 24,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "WhatsApp Messages Today",
      "type": "stat",
      "targets": [{ "expr": "increase(agritrust_business_events_total{metric=\"whatsapp_messages\"}[24h])", "legendFormat": "WhatsApp" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 15 },
      "id": 25,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Open Disputes",
      "type": "stat",
      "targets": [{ "expr": "agritrust_business_events_total{metric=\"open_disputes\"}", "legendFormat": "Disputes" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 30,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Orders & Transactions (24h)",
      "type": "timeseries",
      "targets": [
        { "expr": "increase(agritrust_business_events_total{metric=\"orders_created\"}[1h])", "legendFormat": "Orders Created" },
        { "expr": "increase(agritrust_business_events_total{metric=\"orders_completed\"}[1h])", "legendFormat": "Orders Completed" },
        { "expr": "increase(agritrust_business_events_total{metric=\"payments_processed\"}[1h])", "legendFormat": "Payments" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "lineWidth": 2, "fillOpacity": 15 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 31,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Revenue & Escrow Volume",
      "type": "timeseries",
      "targets": [
        { "expr": "increase(agritrust_business_events_total{metric=\"platform_revenue_usd\"}[1h])", "legendFormat": "Platform Revenue" },
        { "expr": "agritrust_business_events_total{metric=\"escrow_held_usd\"}", "legendFormat": "Escrow Held" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "title": "🖥️ Infrastructure",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.9 }] } } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "id": 40,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "CPU Utilization by Pod",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(container_cpu_usage_seconds_total{namespace=\"agritrust\"}[5m])", "legendFormat": "{{pod}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
      "id": 41,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Memory Usage by Pod",
      "type": "timeseries",
      "targets": [
        { "expr": "container_memory_working_set_bytes{namespace=\"agritrust\"}", "legendFormat": "{{pod}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "id": 42,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Pod Replica Count",
      "type": "timeseries",
      "targets": [
        { "expr": "kube_deployment_status_replicas_available{namespace=\"agritrust\"}", "legendFormat": "{{deployment}}" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "id": 104,
      "title": "📝 Recent Logs",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 37 },
      "id": 50,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "title": "Backend Errors",
      "type": "logs",
      "targets": [{ "expr": "{app=\"agritrust-backend\"} |= \"ERROR\"", "legendFormat": "" }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["agritrust", "production", "overview"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "Africa/Harare",
  "title": "ZimAgriTrust – Production Overview",
  "uid": "agritrust-main",
  "version": 1
}
