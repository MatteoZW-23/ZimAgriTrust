# Production Environment Variables
# Copy this file to .env.production and fill in actual values
# SECURITY WARNING: ALL values marked CHANGE_THIS must be set to secure random values
# Use: openssl rand -hex 32  (for 64-character hex strings)

# =============================================================================
# DATABASE SECURITY (REQUIRED)
# =============================================================================
POSTGRES_DB=agri_trust
POSTGRES_USER=agritrust
# CRITICAL: Must be strong password, 32+ characters recommended
# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD_32_CHARS_MIN

# =============================================================================
# REDIS SECURITY (REQUIRED)
# =============================================================================
# CRITICAL: Redis AUTH password - must match across all services
# Generate: openssl rand -hex 32
REDIS_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD_32_CHARS_MIN

# =============================================================================
# APPLICATION SECURITY KEYS (CRITICAL - DO NOT USE DEFAULTS)
# =============================================================================
# JWT signing keys - MUST be 32+ character high-entropy secrets
# Generate: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_HIGH_ENTROPY_SECRET_KEY_MIN_32_CHARS
REFRESH_SECRET_KEY=CHANGE_THIS_TO_DIFFERENT_HIGH_ENTROPY_SECRET_KEY_MIN_32_CHARS
PIN_PEPPER=CHANGE_THIS_TO_DIFFERENT_SECRET_16_CHARS_MIN

# Admin bootstrap token - must be changed from default
ADMIN_BOOTSTRAP_TOKEN=CHANGE_THIS_TO_SECURE_BOOTSTRAP_TOKEN
API_URL=https://api.agritrust.com
CORS_ORIGINS=https://agritrust.com,https://www.agritrust.com,https://admin.agritrust.com,https://agent.agritrust.com
ALLOWED_HOSTS=agritrust.com,www.agritrust.com,admin.agritrust.co
m,agent.agritrust.com

# =============================================================================
# PAYMENT PROVIDER WEBHOOK SECRETS (CRITICAL - MANDATORY FOR PRODUCTION)
# =============================================================================
# These secrets are REQUIRED for webhook signature verification
# Without these, payment callbacks will be REJECTED (fail-closed security)
# Get these from your payment provider dashboard

# EcoCash Webhook Secret (REQUIRED)
ECOCASH_WEBHOOK_SECRET=CHANGE_THIS_TO_SECRET_FROM_ECOCASH_DASHBOARD

# OneMoney Webhook Secret (REQUIRED)
ONEMONEY_WEBHOOK_SECRET=CHANGE_THIS_TO_SECRET_FROM_ONEMONEY_DASHBOARD

# ZIPIT Webhook Secret (if using ZIPIT)
ZIPIT_WEBHOOK_SECRET=CHANGE_THIS_TO_SECRET_FROM_ZIPIT_DASHBOARD

# =============================================================================
# SUPER ADMIN SECURITY (CRITICAL)
# =============================================================================
# Must be DIFFERENT from SECRET_KEY
SUPER_ADMIN_SECRET_KEY=CHANGE_THIS_TO_DIFFERENT_SECRET_KEY_MIN_32_CHARS
SUPER_ADMIN_IP_WHITELIST=1.2.3.4,5.6.7.8  # Restrict to specific IPs
SUPER_ADMIN_HARDWARE_MFA_REQUIRED=true

# Transaction signing key for financial integrity
TRANSACTION_SIGNING_KEY=CHANGE_THIS_TO_FINANCIAL_SIGNING_KEY_MIN_32_CHARS
AUDIT_CHAIN_KEY=CHANGE_THIS_TO_AUDIT_SIGNING_KEY_MIN_32_CHARS

# =============================================================================
# ADMIN SECURITY
# =============================================================================
ADMIN_IP_WHITELIST=1.2.3.4,5.6.7.8  # Comma-separated list of admin IPs
ADMIN_MFA_ENABLED=true
ADMIN_AUDIT_LOGGING=true

# =============================================================================
# PLATFORM SECURITY
# =============================================================================
# NEVER enable in production
MASTER_TEST_LOGIN_ENABLED=false
AUTO_CONFIRM_PAYMENTS=false

# Rate limiting
RATE_LIMIT_ENABLED=true

# Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=INFO

# Grafana
GRAFANA_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# SSL Certificate Paths (for nginx)
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# SMS Configuration (AfricasTalking)
SMS_API_KEY=your-api-key
SMS_USERNAME=your-username
SMS_SENDER_ID=ZimAgriTrust

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# Use app-specific password, not main account password
SMTP_PASSWORD=CHANGE_THIS_TO_APP_SPECIFIC_PASSWORD
SMTP_FROM=noreply@agritrust.com

# =============================================================================
# DEPLOYMENT VERIFICATION CHECKLIST
# =============================================================================
# Before production deploy, verify:
# [ ] All CHANGE_THIS_ values have been replaced with secure random strings
# [ ] SECRET_KEY, REFRESH_SECRET_KEY, SUPER_ADMIN_SECRET_KEY are all DIFFERENT
# [ ] All keys are 32+ characters (64 hex characters from openssl rand -hex 32)
# [ ] ECOCASH_WEBHOOK_SECRET is configured (payment callbacks will fail without)
# [ ] ONEMONEY_WEBHOOK_SECRET is configured (payment callbacks will fail without)
# [ ] REDIS_PASSWORD is configured (Redis AUTH required)
# [ ] POSTGRES_PASSWORD is strong and not default
# [ ] MASTER_TEST_LOGIN_ENABLED is explicitly set to "false"
# [ ] AUTO_CONFIRM_PAYMENTS is explicitly set to "false"
# [ ] ADMIN_IP_WHITELIST restricts admin access to known IPs
# [ ] SUPER_ADMIN_IP_WHITELIST restricts super-admin to specific IPs
# [ ] CORS_ORIGINS contains only production domains (no localhost)
# [ ] ALLOWED_HOSTS contains only production domains
