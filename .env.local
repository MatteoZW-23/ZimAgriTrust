# Local Development Environment Variables
# Copy this to .env file: cp .env.local .env

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=agritrust
POSTGRES_PASSWORD=devpassword123

# =============================================================================
# REDIS
# =============================================================================
REDIS_PASSWORD=devredis123

# =============================================================================
# SECURITY KEYS (for local dev only - use strong secrets in production)
# =============================================================================
SECRET_KEY=dev-secret-key-for-local-development-only-32-chars
REFRESH_SECRET_KEY=dev-refresh-key-for-local-development-only-32
PIN_PEPPER=dev-pepper-16-chars
ADMIN_BOOTSTRAP_TOKEN=dev-bootstrap-token-local-only

# =============================================================================
# WEBHOOK SECRETS (for local testing)
# =============================================================================
ECOCASH_WEBHOOK_SECRET=ecocash-webhook-secret-local-dev
ONEMONEY_WEBHOOK_SECRET=onemoney-webhook-secret-local-dev
ZIPIT_WEBHOOK_SECRET=zipit-webhook-secret-local-dev

# =============================================================================
# SUPER ADMIN
# =============================================================================
SUPER_ADMIN_SECRET_KEY=dev-super-admin-key-for-local-development-only
TRANSACTION_SIGNING_KEY=dev-transaction-signing-key-local-only-32
AUDIT_CHAIN_KEY=dev-audit-chain-key-local-only-32-chars

# =============================================================================
# APP CONFIG
# =============================================================================
APP_ENV=development
MASTER_TEST_LOGIN_ENABLED=false
AUTO_CONFIRM_PAYMENTS=false
ADMIN_AUDIT_LOGGING=false

# =============================================================================
# INSTRUCTIONS
# =============================================================================
# To use this file:
#   1. cp .env.local .env
#   2. docker compose up --build
#
# For production, use .env.production with real secrets!
DATABASE_URL=postgresql+psycopg2://agritrust:devpassword123@postgres:5432/zimagritrust
