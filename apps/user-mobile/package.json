{
  "name": "zimagritrust-user-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "web": "npx expo start --web",
    "export:web": "npx expo export --platform web",
    "build:android": "npx eas-cli@latest build --profile production --platform android",
    "build:ios": "npx eas-cli@latest build --profile production --platform ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "expo": "~51.0.0",
    "expo-build-properties": "~0.12.1",
    "expo-camera": "~15.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-web": "~0.19.10",
    "lucide-react-native": "^0.400.0",
    "@react-navigation/native": "^6.0.0",
    "@react-navigation/stack": "^6.0.0",
    "@react-navigation/bottom-tabs": "^6.0.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-svg": "15.2.0",
    "expo-image-picker": "~15.1.0",
    "expo-location": "~17.0.0",
    "expo-notifications": "~0.28.1",
    "expo-secure-store": "~13.0.0",
    "expo-status-bar": "~1.12.1",
    "expo-constants": "~16.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0"
  }
}
