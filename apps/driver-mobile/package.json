    "build:android": "npx eas-cli@latest build --profile production --platform android",
    "build:ios": "npx eas-cli@latest build --profile production --platform ios",
    "submit:android": "npx eas-cli@latest submit --platform android",
    "submit:ios": "npx eas-cli@latest submit --platform ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
