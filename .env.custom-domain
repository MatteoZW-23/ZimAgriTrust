# Custom Domain Configuration for ZimAgriTrust
# Replace YOURDOMAIN.COM with your actual domain

# Domain settings
DOMAIN_NAME=YOURDOMAIN.COM
BASE_URL=https://YOURDOMAIN.COM
API_BASE_URL=https://YOURDOMAIN.COM/api/v1

# CORS settings for your custom domain
CORS_ORIGINS=https://YOURDOMAIN.COM,https://www.YOURDOMAIN.COM,https://admin.YOURDOMAIN.COM,https://agent.YOURDOMAIN.COM
ALLOWED_HOSTS=YOURDOMAIN.COM,www.YOURDOMAIN.COM,admin.YOURDOMAIN.COM,agent.YOURDOMAIN.COM

# SSL Certificate settings (if using HTTPS)
SSL_CERT_PATH=/etc/nginx/ssl/YOURDOMAIN.COM.crt
SSL_KEY_PATH=/etc/nginx/ssl/YOURDOMAIN.COM.key

# Email settings for domain verification
EMAIL_DOMAIN=YOURDOMAIN.COM
EMAIL_NOREPLY=noreply@YOURDOMAIN.COM
