APP_NAME=Agri Trust Marketplace API
API_V1_STR=/api/v1
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/zimagritrust
REDIS_URL=redis://localhost:6380/0
CORS_ORIGINS=http://localhost:3000,http://localhost:19006,http://localhost:5000
ALLOWED_HOSTS=localhost,127.0.0.1
FORCE_HTTPS=false
MASTER_TEST_LOGIN_ENABLED=false

# === SUPER ADMIN (cash security) ===
# MUST be a high-entropy string DIFFERENT from SECRET_KEY in production.
SUPER_ADMIN_SECRET_KEY=
SUPER_ADMIN_TOKEN_EXPIRE_MINUTES=30
SUPER_ADMIN_IP_WHITELIST=
SUPER_ADMIN_HARDWARE_MFA_REQUIRED=true
SUPER_ADMIN_ALERT_PHONE=
SUPER_ADMIN_ALERT_EMAIL=

# === FINANCIAL INTEGRITY ===
TRANSACTION_SIGNING_KEY=
AUDIT_CHAIN_KEY=

# === WITHDRAWAL FEES / LIMITS ===
WITHDRAWAL_FEE_PERCENT=0.01
WITHDRAWAL_FEE_CAP=5
WITHDRAWAL_MIN_AMOUNT=5
WITHDRAWALS_PER_DAY_MAX=3
DEPOSIT_ATTEMPTS_PER_HOUR_MAX=10
PAYMENT_ATTEMPTS_PER_TRANSACTION_MAX=5

# === DUAL / MULTI APPROVAL ===
DUAL_APPROVAL_REFUND_THRESHOLD_USD=100
MULTI_APPROVAL_TXN_THRESHOLD_USD=2000
FINANCE_ADMIN_APPROVAL_LIMIT_USD=500
SENIOR_ADMIN_APPROVAL_LIMIT_USD=2000

# === FINANCIAL HOURS (Zimbabwe CAT, UTC+2) ===
FINANCIAL_APPROVAL_TIME_WINDOW_ENABLED=true
FINANCIAL_APPROVAL_HOURS_START=8
FINANCIAL_APPROVAL_HOURS_END=17
FINANCIAL_APPROVAL_TZ_OFFSET_HOURS=2

# === ESCROW TWO-KEY ===
ESCROW_ADMIN_OTP_TTL_SECONDS=300

# === FRAUD DETECTION ===
FRAUD_VELOCITY_WINDOW_SECONDS=3600
FRAUD_VELOCITY_THRESHOLD=2
FRAUD_STRUCTURING_GAP_PERCENT=0.05
FRAUD_NEW_USER_DAYS=7
FRAUD_NEW_USER_LARGE_WITHDRAWAL_USD=100
FRAUD_TRUST_SCORE_SPIKE_THRESHOLD=30

# === BUYER DEPOSITS ===
DEPOSIT_MIN_AMOUNT=5
DEPOSIT_REFUND_WINDOW_DAYS=7
DEPOSIT_REFUND_FEE_PERCENT=0.02
DEPOSIT_REFUND_FEE_CAP=10
DEPOSIT_INSURANCE_PER_USER_USD=500
PARTNER_BANK_NAME=CABS Bank
PARTNER_BANK_ACCOUNT_NAME=ZimAgriTrust Trust Account
PARTNER_BANK_ACCOUNT_NUMBER=1000000000
PARTNER_BANK_BRANCH_CODE=CABSZWHA

# === INPUT MARKETPLACE ===
INPUT_PLATFORM_FEE_PERCENT=0.025
INPUT_ESCROW_FEE_PERCENT=0.005
INPUT_BOOST_FEE_USD=2
INPUT_VERIFICATION_FEE_REGULATED_USD=2
INPUT_VERIFICATION_FEE_BASIC_USD=1
INPUT_SELLER_MIN_TRUST_SCORE=40
INPUT_BULK_ORDER_MIN_USD=500
INPUT_EXPIRY_WARNING_DAYS=7
