# ZimAgriTrust — Production Environment Configuration
# Copy to .env and set real values. NEVER commit .env with real secrets.
# Generate secrets: python -c "import secrets; print(secrets.token_hex(32))"

# ==============================================================================
# CORE
# ==============================================================================
APP_ENV=production
APP_NAME=Agri Trust Marketplace API
LOG_LEVEL=INFO

# ==============================================================================
# DATABASE (PostgreSQL)
# ==============================================================================
POSTGRES_USER=agritrust
POSTGRES_PASSWORD=             # REQUIRED — 20+ chars, random
POSTGRES_DB=zimagritrust
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_STATEMENT_TIMEOUT_MS=30000

# ==============================================================================
# REDIS
# ==============================================================================
REDIS_PASSWORD=                # REQUIRED — strong random string
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ==============================================================================
# AUTHENTICATION — All secrets MUST be >=32 chars, no placeholders
# ==============================================================================
SECRET_KEY=                    # REQUIRED — openssl rand -hex 32
REFRESH_SECRET_KEY=            # REQUIRED — openssl rand -hex 32
PIN_PEPPER=                    # REQUIRED — openssl rand -hex 16 (min 16 chars)
ADMIN_BOOTSTRAP_TOKEN=         # REQUIRED — used for initial super-admin creation
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ==============================================================================
# CORS & HOSTS
# ==============================================================================
CORS_ORIGINS=https://agritrust.co.zw,https://admin.agritrust.co.zw,https://agent.agritrust.co.zw,https://app.agritrust.co.zw
ALLOWED_HOSTS=agritrust.co.zw,admin.agritrust.co.zw,agent.agritrust.co.zw,app.agritrust.co.zw
FORCE_HTTPS=true

# ==============================================================================
# FRONTEND URLS
# ==============================================================================
FRONTEND_URL=https://agritrust.co.zw
ADMIN_DASHBOARD_URL=https://admin.agritrust.co.zw
AGENT_PORTAL_URL=https://agent.agritrust.co.zw
APP_PORTAL_URL=https://app.agritrust.co.zw
SUPPLIER_PORTAL_URL=https://supplier.agritrust.co.zw

# ==============================================================================
# SUPER ADMIN (highest privilege tier)
# ==============================================================================
SUPER_ADMIN_SECRET_KEY=        # REQUIRED — must differ from SECRET_KEY
SUPER_ADMIN_IP_WHITELIST=      # comma-separated IPs, empty = disabled
SUPER_ADMIN_ALERT_PHONE=       # e.g. +263771234567
SUPER_ADMIN_ALERT_EMAIL=       # e.g. cto@agritrust.co.zw

# ==============================================================================
# ADMIN SECURITY
# ==============================================================================
ADMIN_IP_WHITELIST=            # comma-separated, empty = disabled
ADMIN_SESSION_TIMEOUT_MINUTES=30
ADMIN_MFA_ENABLED=true
ADMIN_AUDIT_LOGGING=true

# ==============================================================================
# FINANCIAL INTEGRITY
# ==============================================================================
TRANSACTION_SIGNING_KEY=       # HMAC key for fund movement signing
AUDIT_CHAIN_KEY=               # HMAC key for tamper-proof audit chain

# ==============================================================================
# PARTNER BANK (for buyer deposits)
# ==============================================================================
PARTNER_BANK_NAME=CABS Bank
PARTNER_BANK_ACCOUNT_NAME=ZimAgriTrust Trust Account
PARTNER_BANK_ACCOUNT_NUMBER=   # REQUIRED for deposits
PARTNER_BANK_BRANCH_CODE=CABSZWHA

# ==============================================================================
# SMS (Africa's Talking)
# ==============================================================================
SMS_API_KEY=                   # REQUIRED for OTP / alerts
SMS_USERNAME=                  # Africa's Talking username
SMS_SENDER_ID=ZimAgriTrust

# ==============================================================================
# WHATSAPP (Business API)
# ==============================================================================
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# ==============================================================================
# EMAIL
# ==============================================================================
EMAIL_PROVIDER=sendgrid        # sendgrid, ses, smtp, console
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=security@zimagritrust.co.zw
EMAIL_FROM_NAME=ZimAgriTrust Security
EMAIL_REPLY_TO=support@zimagritrust.co.zw

# SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ==============================================================================
# MONITORING
# ==============================================================================
SENTRY_DSN=                    # Sentry error tracking DSN
OPENWEATHER_API_KEY=           # For live weather data on public site

# ==============================================================================
# PAYMENT GATEWAY
# ==============================================================================
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
STRIPE_SECRET_KEY=

# ==============================================================================
# GUNICORN (backend workers)
# ==============================================================================
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=60
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# ==============================================================================
# GRAFANA (monitoring dashboard)
# ==============================================================================
GRAFANA_PASSWORD=              # REQUIRED for docker-compose.prod.yml

# ==============================================================================
# SAFETY FLAGS — MUST stay False/off in production
# ==============================================================================
MASTER_TEST_LOGIN_ENABLED=false
AUTO_CONFIRM_PAYMENTS=false
ENABLE_USSD_DEBUG_TOOLS=false
ENABLE_WHATSAPP_TEST_ENDPOINTS=false
PLATFORM_SHUTDOWN=false
