# ============================================
# AGRITRUST - ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Copy this file to .env and fill in values

# ===== BACKEND =====
DATABASE_URL=postgresql://user:password@postgres:5432/agritrust
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== API =====
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# ===== USSD =====
USSD_GATEWAY_URL=https://api.ussd-gateway.com
USSD_API_KEY=
USSD_SHORTCODE=*123#

# ===== PAYMENT GATEWAY =====
ECOCASH_API_KEY=
ECOCASH_API_SECRET=
ECOCASH_MERCHANT_ID=

# ===== SMS =====
SMS_PROVIDER=africastalking
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER_ID=AgriTrust

# ===== ML MODELS =====
ML_MODEL_PATH=./ml_weights
PRICE_MODEL_VERSION=v2
RISK_MODEL_VERSION=v4
FRAUD_MODEL_VERSION=v1

# ===== AGENTS =====
AGENT_ASSIGNMENT_ALGORITHM=weighted
MAX_AGENT_LOAD=5

# ===== MONITORING =====
SENTRY_DSN=
PROMETHEUS_ENABLED=true
GRAFANA_API_KEY=

# ===== ENVIRONMENT =====
ENVIRONMENT=development  # development/staging/production
DEBUG=false
LOG_LEVEL=info
