# AgriTrust Backend Environment Configuration
# Copy this to .env and fill in your local values

# ==============================================================================
# ENVIRONMENT
# ==============================================================================

# Deployment environment: development, staging, production
ENVIRONMENT=development

# Enable debug mode (only in development!)
DEBUG=true

# ==============================================================================
# DATABASE
# ==============================================================================

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# Local development:
DATABASE_URL=postgresql://postgres:password@localhost:5432/zimagritrust

# Connection pooling
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Enable SQL query logging (development only)
DATABASE_ECHO=false

# ==============================================================================
# CACHE
# ==============================================================================

# Redis connection string
# Format: redis://[:password]@host:port/db
REDIS_URL=redis://localhost:6379/0

# Cache TTLs (seconds)
REDIS_DEFAULT_TTL=3600
LOCAL_CACHE_TTL=60

# ==============================================================================
# AUTHENTICATION
# ==============================================================================

# JWT Secret (generate with: openssl rand -hex 32)
# MUST be at least 32 characters in production
JWT_SECRET=your-super-secret-key-change-this-in-production-min-32-chars!

# JWT Algorithm (HS256, HS384, HS512)
JWT_ALGORITHM=HS256

# Token expiry times (minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ==============================================================================
# SECURITY
# ==============================================================================

# Failed login tracking
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# Password policy
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_AGE_DAYS=90

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Trusted hosts for DNS rebinding protection
TRUSTED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ==============================================================================
# LOGGING
# ==============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json or text
LOG_FORMAT=text

# ==============================================================================
# EXTERNAL SERVICES
# ==============================================================================

# Sentry error tracking (optional)
# SENTRY_DSN=https://key@sentry.io/project-id

# Email service (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@agritrust.co.zw

# SMS service (for OTP, alerts)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# Payment gateway integration
# STRIPE_API_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ML Model Service
# ML_SERVICE_URL=http://ml-service:8001
# ML_API_KEY=your-api-key

# ==============================================================================
# KUBERNETES / DOCKER
# ==============================================================================

# Application port
APP_PORT=8000

# Number of worker processes (gunicorn/uvicorn)
# Set to 0 to auto-detect (recommended)
WORKERS=0

# ==============================================================================
# DEVELOPMENT TOOLS
# ==============================================================================

# Reload on code changes (development only)
RELOAD=true

# Verbose error messages
VERBOSE_ERRORS=true

# ==============================================================================
# NOTES
# ==============================================================================

# DO NOT commit this file with real secrets!
# Use a secrets management tool in production (AWS Secrets Manager, HashiCorp Vault)

# Generate secure random strings:
# - OpenSSL: openssl rand -hex 32
# - Python: python -c "import secrets; print(secrets.token_hex(32))"
# - Linux/Mac: head -c 32 /dev/urandom | xxd -p

# Database password requirements (production):
# - 20+ characters
# - Mix of uppercase, lowercase, numbers, symbols
# - No common words or patterns

# JWT Secret requirements (production):
# - 32+ characters
# - Random and unique per environment
# - Rotate quarterly
